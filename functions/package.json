{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "lint": "eslint .",
    "test": "node --test test/manufacturer_event_deduplicator.test.js",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test:rules": "firebase emulators:exec --only firestore --config ../firebase.rules-test.json --project demo-safehood-rules-test \"npm run test:rules:unit\"",
    "test:rules:unit": "node --test --test-concurrency=1 test/firestore_rules.test.js test/user_device_rules.test.js test/incident_rules.test.js test/bridge_rules.test.js",
    "test:account-deletion:unit": "node --test test/account_deletion.test.js",
    "test:account-deletion": "firebase emulators:exec --only firestore --config ../firebase.rules-test.json --project demo-safehood-rules-test \"npm run test:account-deletion:unit\""
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^14.4.0",
    "firebase-functions": "^7.4.0",
    "geofire-common": "^6.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "eslint": "^8.15.0",
    "eslint-config-google": "^0.14.0",
    "firebase": "^12.19.0"
  },
  "private": true
}
