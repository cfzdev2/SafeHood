rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write:
        if request.auth != null
        && request.auth.uid == userId;

      match /cameras/{cameraId} {
  function isCameraOwner() {
    return request.auth != null
        && request.auth.uid == userId;
  }

  function isValidCameraUpdate() {
    let changedKeys = request.resource.data
        .diff(resource.data)
        .affectedKeys();

    return changedKeys.hasOnly([
          'name',
          'locationName',
          'motionDetectionEnabled',
          'notificationSettings',
          'isOnline',
          'availabilityCheckedAt',
          'updatedAt'
        ])
        && request.resource.data.updatedAt
           == request.time

        && (
          !changedKeys.hasAny(['name'])
          || (
            request.resource.data.name
              is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 60
          )
        )

        && (
          !changedKeys.hasAny(['locationName'])
          || (
            request.resource.data.locationName
              is string
            && request.resource.data.locationName.size() > 0
            && request.resource.data.locationName.size() <= 100
          )
        )

        && (
          !changedKeys.hasAny([
            'motionDetectionEnabled'
          ])
          || request.resource.data.motionDetectionEnabled
             is bool
        )

        && (
          !changedKeys.hasAny([
            'notificationSettings'
          ])
          || request.resource.data.notificationSettings
             is map
        )

        && (
          !changedKeys.hasAny([
            'isOnline',
            'availabilityCheckedAt'
          ])
          || (
            changedKeys.hasAll([
              'isOnline',
              'availabilityCheckedAt'
            ])
            && request.resource.data.isOnline
               is bool
            && request.resource.data.availabilityCheckedAt
               == request.time
          )
        );
  }

  allow read:
    if isCameraOwner();

  // Dodawanie kamery pozostaje na razie
  // po stronie aplikacji użytkownika.
  allow create:
    if isCameraOwner();

  allow update:
    if isCameraOwner()
    && isValidCameraUpdate();

  // Usuwanie odbywa się wyłącznie przez
  // bezpieczną funkcję Cloud Functions.
  allow delete:
    if false;
}

      match /bridges/{bridgeId} {
        // Status Bridge może odczytać
        // wyłącznie jego właściciel.
        allow read:
          if request.auth != null
          && request.auth.uid == userId;

        // Status zapisuje wyłącznie Bridge
        // przez Firebase Admin SDK.
        allow create, update, delete:
          if false;
      }

      match /devices/{deviceId} {
        allow read:
          if request.auth != null
          && request.auth.uid == userId;

        allow create, update:
          if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.fid
             == deviceId
          && request.resource.data.fcmToken
             is string
          && request.resource.data.platform
             is string
          && request.resource.data.notificationsAllowed
             is bool;

        allow delete:
          if request.auth != null
          && request.auth.uid == userId;
      }
    }

    match /communityProfiles/{userId} {
      allow read:
        if request.auth != null;

      allow write:
        if request.auth != null
        && request.auth.uid == userId;
    }

    match /incidents/{incidentId} {
      allow read:
        if request.auth != null
        && request.auth.uid
           in resource.data.participantIds;

      allow create: if false;

      allow update:
        if request.auth != null
        && request.auth.uid
           == resource.data.reporterId
        && request.resource.data.reporterId
           == resource.data.reporterId
        && request.resource.data.participantIds
           == resource.data.participantIds;

      allow delete: if false;

      match /responses/{responseUserId} {
        function isParticipant() {
          return request.auth != null
              && request.auth.uid in get(
                /databases/$(database)/documents/incidents/$(incidentId)
              ).data.participantIds;
        }

        allow read:
          if isParticipant();

        // Reakcje zapisuje backend.
        allow create, update, delete:
          if false;
      }

      match /messages/{messageId} {
        function isParticipant() {
          return request.auth != null
              && request.auth.uid in get(
                /databases/$(database)/documents/incidents/$(incidentId)
              ).data.participantIds;
        }

        allow read:
          if isParticipant();

        // Wiadomości zapisuje backend.
        allow create, update, delete:
          if false;
      }
    }

    match /cameraEvents/{eventId} {

      // Event może zobaczyć wyłącznie
      // właściciel kamery.
      allow read:
        if request.auth != null
        && resource.data.ownerId
           == request.auth.uid;

      // Eventy tworzy wyłącznie backend.
      allow create: if false;

      // Eventów nie usuwamy z aplikacji.
      allow delete: if false;

      // Aplikacja może zmienić wyłącznie:
      // status + updatedAt.
      //
      // Dozwolone:
      // new -> viewed
      // new -> dismissed
      // viewed -> dismissed
      //
      // escalated będzie później
      // ustawiał wyłącznie backend.
      allow update:
        if request.auth != null
        && resource.data.ownerId
           == request.auth.uid

        && request.resource.data.ownerId
           == resource.data.ownerId

        && request.resource.data
             .diff(resource.data)
             .affectedKeys()
             .hasOnly([
               'status',
               'updatedAt'
             ])

        && (
          (
            resource.data.status == 'new'
            && request.resource.data.status
               == 'viewed'
          )
          ||
          (
            (
              resource.data.status == 'new'
              || resource.data.status
                 == 'viewed'
            )
            && request.resource.data.status
               == 'dismissed'
          )
        );
    }
  }
}