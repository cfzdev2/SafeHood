rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
  function isUserOwner() {
    return request.auth != null
        && request.auth.uid == userId;
  }

  function isValidUserProfile() {
    return request.resource.data.firstName
             is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.firstName.size() <= 60

        && request.resource.data.phoneNumber
           is string
        && request.resource.data.phoneNumber.size() <= 32

        && request.resource.data.address
           is string
        && request.resource.data.address.size() <= 200

        && request.resource.data.notificationsEnabled
           is bool

        && (
          request.resource.data.email == null
          || (
            request.resource.data.email
              is string
            && request.resource.data.email.size() <= 320
          )
        )

        && (
          (
            request.resource.data.latitude == null
            && request.resource.data.longitude == null
            && request.resource.data.geo == null
          )
          ||
          (
            request.resource.data.latitude
              is number
            && request.resource.data.latitude >= -90
            && request.resource.data.latitude <= 90

            && request.resource.data.longitude
               is number
            && request.resource.data.longitude >= -180
            && request.resource.data.longitude <= 180

            && request.resource.data.geo
               is map
          )
        )

        && request.resource.data.updatedAt
           == request.time;
  }

  allow read:
    if isUserOwner();

  allow create:
    if isUserOwner()
    && request.resource.data.keys().hasAll([
      'firstName',
      'phoneNumber',
      'address',
      'latitude',
      'longitude',
      'notificationsEnabled',
      'email',
      'geo',
      'updatedAt'
    ])
    && request.resource.data.keys().hasOnly([
      'firstName',
      'phoneNumber',
      'address',
      'latitude',
      'longitude',
      'notificationsEnabled',
      'email',
      'geo',
      'updatedAt'
    ])
    && isValidUserProfile();

  allow update:
    if isUserOwner()
    && request.resource.data
         .diff(resource.data)
         .affectedKeys()
         .hasOnly([
           'firstName',
           'phoneNumber',
           'address',
           'latitude',
           'longitude',
           'notificationsEnabled',
           'email',
           'geo',
           'updatedAt'
         ])
    && isValidUserProfile();

  allow delete:
    if false;

      match /cameras/{cameraId} {
  function isCameraOwner() {
    return request.auth != null
        && request.auth.uid == userId;
  }

  function isValidCameraUpdate() {
    let changedKeys = request.resource.data
        .diff(resource.data)
        .affectedKeys();

    return changedKeys.hasOnly([
          'name',
          'locationName',
          'motionDetectionEnabled',
          'notificationSettings',
          'isOnline',
          'availabilityCheckedAt',
          'updatedAt'
        ])
        && request.resource.data.updatedAt
           == request.time

        && (
          !changedKeys.hasAny(['name'])
          || (
            request.resource.data.name
              is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 60
          )
        )

        && (
          !changedKeys.hasAny(['locationName'])
          || (
            request.resource.data.locationName
              is string
            && request.resource.data.locationName.size() > 0
            && request.resource.data.locationName.size() <= 100
          )
        )

        && (
          !changedKeys.hasAny([
            'motionDetectionEnabled'
          ])
          || request.resource.data.motionDetectionEnabled
             is bool
        )

        && (
          !changedKeys.hasAny([
            'notificationSettings'
          ])
          || request.resource.data.notificationSettings
             is map
        )

        && (
          !changedKeys.hasAny([
            'isOnline',
            'availabilityCheckedAt'
          ])
          || (
            changedKeys.hasAll([
              'isOnline',
              'availabilityCheckedAt'
            ])
            && request.resource.data.isOnline
               is bool
            && request.resource.data.availabilityCheckedAt
               == request.time
          )
        );
  }

  allow read:
    if isCameraOwner();

  // Dodawanie kamery pozostaje na razie
  // po stronie aplikacji użytkownika.
  allow create:
    if isCameraOwner();

  allow update:
    if isCameraOwner()
    && isValidCameraUpdate();

  // Usuwanie odbywa się wyłącznie przez
  // bezpieczną funkcję Cloud Functions.
  allow delete:
    if false;
}

      match /bridges/{bridgeId} {
        // Status Bridge może odczytać
        // wyłącznie jego właściciel.
        allow read:
          if request.auth != null
          && request.auth.uid == userId;

        // Status zapisuje wyłącznie Bridge
        // przez Firebase Admin SDK.
        allow create, update, delete:
          if false;
      }

      match /devices/{deviceId} {
  function isDeviceOwner() {
    return request.auth != null
        && request.auth.uid == userId;
  }

  function isValidDevice() {
    return request.resource.data.keys().hasAll([
          'fid',
          'fcmToken',
          'platform',
          'notificationsAllowed',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'fid',
          'fcmToken',
          'platform',
          'notificationsAllowed',
          'updatedAt'
        ])

        && request.resource.data.fid
           is string
        && request.resource.data.fid
           == deviceId
        && request.resource.data.fid.size() > 0
        && request.resource.data.fid.size() <= 200

        && request.resource.data.fcmToken
           is string
        && request.resource.data.fcmToken.size() > 0
        && request.resource.data.fcmToken.size() <= 4096

        && request.resource.data.platform
           in [
             'android',
             'iOS'
           ]

        && request.resource.data.notificationsAllowed
           is bool

        && request.resource.data.updatedAt
           == request.time;
  }

  allow read:
    if isDeviceOwner();

  allow create, update:
    if isDeviceOwner()
    && isValidDevice();

  // Wylogowanie może usunąć wyłącznie
  // urządzenie zalogowanego użytkownika.
  allow delete:
    if isDeviceOwner();
}
    }

    match /communityProfiles/{userId} {
  function isCommunityProfileOwner() {
    return request.auth != null
        && request.auth.uid == userId;
  }

  function isValidCommunityProfile() {
    return request.resource.data.firstName
             is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.firstName.size() <= 60

        && request.resource.data.notificationsEnabled
           is bool

        && request.resource.data.updatedAt
           == request.time;
  }

  allow read:
    if isCommunityProfileOwner();

  allow create:
    if isCommunityProfileOwner()
    && request.resource.data.keys().hasAll([
      'firstName',
      'notificationsEnabled',
      'updatedAt'
    ])
    && request.resource.data.keys().hasOnly([
      'firstName',
      'notificationsEnabled',
      'updatedAt'
    ])
    && isValidCommunityProfile();

  allow update:
    if isCommunityProfileOwner()
    && request.resource.data
         .diff(resource.data)
         .affectedKeys()
         .hasOnly([
           'firstName',
           'notificationsEnabled',
           'updatedAt'
         ])
    && isValidCommunityProfile();

  allow delete:
    if false;
}

    match /incidents/{incidentId} {
      allow read:
        if request.auth != null
        && request.auth.uid
           in resource.data.participantIds;

      // Zgłoszenia tworzy i modyfikuje
// wyłącznie backend SafeHood.
allow create, update, delete:
  if false;

      match /responses/{responseUserId} {
        function isParticipant() {
          return request.auth != null
              && request.auth.uid in get(
                /databases/$(database)/documents/incidents/$(incidentId)
              ).data.participantIds;
        }

        allow read:
          if isParticipant();

        // Reakcje zapisuje backend.
        allow create, update, delete:
          if false;
      }

      match /messages/{messageId} {
        function isParticipant() {
          return request.auth != null
              && request.auth.uid in get(
                /databases/$(database)/documents/incidents/$(incidentId)
              ).data.participantIds;
        }

        allow read:
          if isParticipant();

        // Wiadomości zapisuje backend.
        allow create, update, delete:
          if false;
      }
    }

    match /cameraEvents/{eventId} {

      // Event może zobaczyć wyłącznie
      // właściciel kamery.
      allow read:
        if request.auth != null
        && resource.data.ownerId
           == request.auth.uid;

      // Eventy tworzy wyłącznie backend.
      allow create: if false;

      // Eventów nie usuwamy z aplikacji.
      allow delete: if false;

      // Aplikacja może zmienić wyłącznie:
      // status + updatedAt.
      //
      // Dozwolone:
      // new -> viewed
      // new -> dismissed
      // viewed -> dismissed
      //
      // escalated będzie później
      // ustawiał wyłącznie backend.
      allow update:
        if request.auth != null
        && resource.data.ownerId
           == request.auth.uid

        && request.resource.data.ownerId
           == resource.data.ownerId

        && request.resource.data
             .diff(resource.data)
             .affectedKeys()
             .hasOnly([
               'status',
               'updatedAt'
             ])

        && (
          (
            resource.data.status == 'new'
            && request.resource.data.status
               == 'viewed'
          )
          ||
          (
            (
              resource.data.status == 'new'
              || resource.data.status
                 == 'viewed'
            )
            && request.resource.data.status
               == 'dismissed'
          )
        );
    }
  }
}